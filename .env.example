API_KEY=dev-secret
UN_ID=un-demo-01
MAX_PARALLEL_JOBS=2
DEFAULT_JOB_TIMEOUT_MS=120000
JOB_RETENTION_DAYS=30
WEB_LOGIN=admin
WEB_PASSWORD=change-this-password
WEB_SESSION_TTL_HOURS=12
WEB_COOKIE_SECURE=false
DEMO_MAIL_LOGIN=demo.user
DEMO_MAIL_PASSWORD=demo-password
YAHOO_MAIL_URL=https://login.yahoo.com/?src=ym&activity=header-signin
YAHOO_MAIL_LOGIN=seeergo@yahoo.com
YAHOO_MAIL_PASSWORD=
YAHOO_MAIL_RECIPIENT=10sydneyfc@gmail.com
BROWSER_HEADLESS=false
BROWSER_STEP_DELAY_MS=350
BROWSER_HOLD_OPEN_MS=5000
BROWSER_CAPTCHA_WAIT_MS=120000
BROWSER_WINDOW_WIDTH=1400
BROWSER_WINDOW_HEIGHT=860
NOVNC_ENABLED=true
NOVNC_BIND_HOST=127.0.0.1
NOVNC_PORT=33303
NOVNC_DISPLAY=:99
NOVNC_GEOMETRY=1440x900x24
# Корни файловой системы, доступные JSON-сценариям (разделитель ОС: ; на Windows, : на Linux)
FILESYSTEM_ALLOWED_ROOTS=./demo-data:./data
CALLBACK_AUTH_TOKEN=
CALLBACK_AUTH_USERNAME=
CALLBACK_AUTH_PASSWORD=
# HTTP or HTTPS origins, comma-separated, without handler paths; client chooses transport.
CALLBACK_ALLOWED_ORIGINS=
# NOVNC_PASSWORD=change-this-vnc-password
# NOVNC_PUBLIC_URL=https://example.org/browser/
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# SERVICE_BASE_URL=http://127.0.0.1:3000

# Windows power management (off by default). Explicit persisted API overrides take precedence per field.
# sleep | hibernate | shutdown; select explicitly. shutdown closes Windows sessions.
POWER_MODE=sleep
POWER_ENABLED=false
POWER_BACKGROUND_ENABLED=false
POWER_DRY_RUN=true
POWER_EXCLUDED_USER=
POWER_USER_IDLE_SECONDS=1800
POWER_CHECK_INTERVAL_SECONDS=60
POWER_GRACE_SECONDS=30
POWER_RESUME_COOLDOWN_SECONDS=300

# External IP check: fallback is used only after a valid primary IP mismatch.
IP_CHECK_URL=https://api.ipify.org?format=json
IP_CHECK_FALLBACK_URL=https://api.2ip.io
