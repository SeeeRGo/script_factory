{
  "info": {
    "_postman_id": "33cd0140-743e-4aa7-9664-8de0719ce9b0",
    "name": "Script Factory — диагностика callback 1С (401/402)",
    "description": "Диагностика HTTP-сервиса 1С с HTTP Basic. Заполните callbackUsername и callbackPassword теми же значениями, что CALLBACK_AUTH_USERNAME и CALLBACK_AUTH_PASSWORD на УН. Не экспортируйте коллекцию с действующими паролями.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Неверный пароль — ожидается 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Script-Factory-Event",
            "value": "job.completed"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-invalid-{{$timestamp}}"
          }
        ],
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{callbackUsername}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{invalidCallbackPassword}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"postman-invalid-{{$guid}}\",\n  \"event\": \"job.completed\",\n  \"occurred_at\": \"{{$isoTimestamp}}\",\n  \"job\": {\n    \"job_id\": \"job_postman_invalid\",\n    \"uid\": \"postman-invalid\",\n    \"un_id\": \"un-postman\",\n    \"status\": \"success\",\n    \"result\": {\n      \"message\": \"Проверка неверного ключа\"\n    },\n    \"error\": null\n  }\n}"
        },
        "url": "{{callbackUrl}}",
        "description": "Использует HTTP Basic; логин и пароль должны соответствовать настройкам HTTP-сервиса 1С."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Неверный ключ возвращает HTTP 401', function () {",
              "  pm.response.to.have.status(401);",
              "});",
              "console.log('Тело ответа 401:', pm.response.text());"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Учётные данные УН — воспроизведение ответа 1С",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('callbackUsername') || !pm.collectionVariables.get('callbackPassword')) {",
              "  throw new Error('Заполните callbackUsername и callbackPassword учётными данными callback с УН');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('После успешной авторизации воспроизводится HTTP 402', function () {",
              "  pm.response.to.have.status(402);",
              "});",
              "console.log('Тело ответа после авторизации:', pm.response.text());"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Script-Factory-Event",
            "value": "job.completed"
          },
          {
            "key": "Idempotency-Key",
            "value": "postman-valid-{{$timestamp}}"
          }
        ],
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{callbackUsername}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{callbackPassword}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_id\": \"postman-valid-{{$guid}}\",\n  \"event\": \"job.completed\",\n  \"occurred_at\": \"{{$isoTimestamp}}\",\n  \"job\": {\n    \"job_id\": \"job_postman_valid\",\n    \"uid\": \"postman-valid\",\n    \"un_id\": \"un-postman\",\n    \"status\": \"success\",\n    \"result\": {\n      \"message\": \"Проверка callback с учётными данными УН\"\n    },\n    \"error\": null\n  }\n}"
        },
        "url": "{{callbackUrl}}",
        "description": "Использует HTTP Basic; логин и пароль должны соответствовать настройкам HTTP-сервиса 1С."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "callbackUrl",
      "value": "https://dev.companya.ru/assistent2_copy/hs/TaskRezult/Rezult/",
      "type": "string"
    },
    {
      "key": "callbackUsername",
      "value": "",
      "type": "string"
    },
    {
      "key": "callbackPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "invalidCallbackPassword",
      "value": "intentionally-invalid-password",
      "type": "string"
    }
  ]
}
