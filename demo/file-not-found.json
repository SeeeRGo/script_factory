{
  "timeout_ms": 5000,
  "retry_policy": {
    "max_attempts": 1,
    "backoff_ms": 200
  },
  "script": {
    "format": "json-workflow",
    "steps": [
      {
        "action": "wait",
        "title": "Подготовка поиска: этап 1",
        "description": "Подготовка поиска: этап 1",
        "params": {
          "duration_ms": 100
        }
      },
      {
        "action": "wait",
        "title": "Подготовка поиска: этап 2",
        "description": "Подготовка поиска: этап 2",
        "params": {
          "duration_ms": 100
        }
      },
      {
        "action": "wait",
        "title": "Подготовка поиска: этап 3",
        "description": "Подготовка поиска: этап 3",
        "params": {
          "duration_ms": 100
        }
      },
      {
        "action": "wait",
        "title": "Подготовка поиска: этап 4",
        "description": "Подготовка поиска: этап 4",
        "params": {
          "duration_ms": 100
        }
      },
      {
        "action": "files_list",
        "title": "Прочитать пустой каталог",
        "description": "Прочитать пустой каталог",
        "params": {
          "directory": "{{root_dir}}"
        },
        "save_as": "files"
      },
      {
        "action": "compute",
        "title": "Проверить найденные файлы",
        "description": "Проверить найденные файлы",
        "params": {
          "expression": "context.files.length>0"
        },
        "save_as": "found"
      },
      {
        "action": "assert",
        "title": "Проверить наличие тестовых файлов",
        "description": "Проверить наличие тестовых файлов",
        "params": {
          "condition": "{{found}}",
          "error_code": "FILE_NOT_FOUND",
          "message": "В учебном каталоге нет файлов"
        }
      },
      {
        "action": "wait",
        "title": "Не выполняется после ошибки: этап 1",
        "description": "Не выполняется после ошибки: этап 1",
        "params": {
          "duration_ms": 100
        }
      },
      {
        "action": "wait",
        "title": "Не выполняется после ошибки: этап 2",
        "description": "Не выполняется после ошибки: этап 2",
        "params": {
          "duration_ms": 100
        }
      },
      {
        "action": "wait",
        "title": "Не выполняется после ошибки: этап 3",
        "description": "Не выполняется после ошибки: этап 3",
        "params": {
          "duration_ms": 100
        }
      }
    ],
    "output": {},
    "context": {
      "root_dir": "./demo-data/empty"
    }
  }
}
