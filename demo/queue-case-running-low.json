{
  "schema_version": 1,
  "id": "running-low",
  "title": "Высокий приоритет приходит во время выполнения низкого",
  "description": "P50 выполняет первую попытку, получает ошибку и запускает вторую. Во время второй попытки поступает P10 и остаётся в очереди, потому что планировщик не вытесняет активный job. P50 окончательно падает с PLUGIN_NOT_RUNNING, после чего P10 запускается и успешно завершается.",
  "config": {
    "max_parallel_jobs": 1
  },
  "timeout_ms": 15000,
  "jobs": [
    {
      "alias": "low",
      "role": "observed",
      "submit": {
        "type": "immediate"
      },
      "payload": {
        "uid": "queue-case-2-low-P50",
        "priority": 50,
        "timeout_ms": 8000,
        "retry_policy": {
          "max_attempts": 2,
          "backoff_ms": 700
        },
        "script": {
          "format": "json-workflow",
          "steps": [
            {
              "action": "wait",
              "title": "Начать фоновую обработку",
              "description": "P50 занимает единственный исполнительный слот.",
              "params": {
                "duration_ms": 500
              }
            },
            {
              "action": "wait",
              "title": "Прочитать реестр",
              "description": "Имитирует чтение входных данных без внешних интеграций.",
              "params": {
                "duration_ms": 500
              }
            },
            {
              "action": "wait",
              "title": "Проверить строки",
              "description": "Продолжает работу, пока P10 уже ожидает в очереди.",
              "params": {
                "duration_ms": 500
              }
            },
            {
              "action": "wait",
              "title": "Сопоставить записи",
              "description": "Показывает, что поступление P10 не прерывает активный P50.",
              "params": {
                "duration_ms": 500
              }
            },
            {
              "action": "wait",
              "title": "Подготовить результат",
              "description": "Завершает подготовительную часть фонового задания.",
              "params": {
                "duration_ms": 500
              }
            },
            {
              "action": "fail",
              "title": "Проверить исполнительный плагин",
              "description": "Контролируемая ошибка; повтор определяется только retry_policy.",
              "params": {
                "error_code": "PLUGIN_NOT_RUNNING",
                "message": "Учебная ошибка исполнителя"
              }
            },
            {
              "action": "wait",
              "title": "Сохранить реестр",
              "description": "Не выполняется после контролируемой ошибки PLUGIN_NOT_RUNNING.",
              "params": {
                "duration_ms": 350
              }
            }
          ],
          "output": {},
          "title": "P50 · Фоновая обработка реестра"
        }
      }
    },
    {
      "alias": "high",
      "role": "observed",
      "submit": {
        "type": "after_attempt",
        "job": "low",
        "attempt": 2,
        "status": "running",
        "delay_ms": 800
      },
      "payload": {
        "uid": "queue-case-2-high-P10",
        "priority": 10,
        "timeout_ms": 8000,
        "retry_policy": {
          "max_attempts": 1,
          "backoff_ms": 100
        },
        "script": {
          "format": "json-workflow",
          "steps": [
            {
              "action": "wait",
              "title": "Принять срочное задание",
              "description": "P10 запускается сразу после ошибки активного P50.",
              "params": {
                "duration_ms": 350
              }
            },
            {
              "action": "wait",
              "title": "Прочитать параметры",
              "description": "Проверяет тестовый JSON срочного задания.",
              "params": {
                "duration_ms": 350
              }
            },
            {
              "action": "wait",
              "title": "Подготовить обновление",
              "description": "Формирует результат без внешних взаимодействий.",
              "params": {
                "duration_ms": 350
              }
            },
            {
              "action": "wait",
              "title": "Применить обновление",
              "description": "Имитирует полезную работу высокоприоритетного задания.",
              "params": {
                "duration_ms": 350
              }
            },
            {
              "action": "wait",
              "title": "Проверить результат",
              "description": "Подтверждает успешное выполнение срочного задания.",
              "params": {
                "duration_ms": 350
              }
            },
            {
              "action": "wait",
              "title": "Завершить P10",
              "description": "Освобождает слот с успешным статусом.",
              "params": {
                "duration_ms": 350
              }
            }
          ],
          "output": {},
          "title": "P10 · Срочное обновление статуса"
        }
      }
    }
  ],
  "expectations": [
    {
      "type": "created_while_running",
      "created": "high",
      "running": "low"
    },
    {
      "type": "starts_after_finished",
      "job": "high",
      "after": "low"
    },
    {
      "type": "attempts",
      "job": "low",
      "count": 2
    },
    {
      "type": "terminal",
      "job": "low",
      "status": "failed",
      "error_code": "PLUGIN_NOT_RUNNING"
    },
    {
      "type": "terminal",
      "job": "high",
      "status": "success"
    }
  ]
}
