{
  "uid": "1c-stage4-delay-001",
  "priority": 30,
  "timeout_ms": 120000,
  "retry_policy": {
    "max_attempts": 2,
    "backoff_ms": 1000
  },
  "context": {
    "delay_ms": 15000,
    "input_dir": "./work/incoming",
    "archive_dir": "./work/archive"
  },
  "callback": {
    "url": "http://1c-test.local:8080/script-factory/result",
    "max_attempts": 5,
    "backoff_ms": 1000,
    "timeout_ms": 5000
  },
  "script": {
    "format": "json-workflow",
    "steps": [
      {
        "action": "set",
        "title": "Принять параметры из 1С",
        "description": "Принять параметры из 1С",
        "params": {
          "accepted": true
        }
      },
      {
        "action": "wait",
        "title": "Управляемая задержка",
        "description": "Управляемая задержка",
        "params": {
          "duration_ms": "{{delay_ms}}"
        }
      },
      {
        "action": "files_list",
        "title": "Прочитать входной каталог",
        "description": "Прочитать входной каталог",
        "params": {
          "directory": "{{input_dir}}"
        },
        "save_as": "input_files"
      },
      {
        "action": "compute",
        "title": "Выбрать учебные XML",
        "description": "Выбрать учебные XML",
        "params": {
          "expression": "context.input_files.filter(f=>f.filename.startsWith(\"TEST_\")&&f.filename.endsWith(\".xml\"))"
        },
        "save_as": "found_files"
      },
      {
        "action": "directory_create",
        "title": "Подготовить архив",
        "description": "Подготовить архив",
        "params": {
          "directory": "{{archive_dir}}"
        }
      },
      {
        "action": "for_each",
        "title": "Скопировать найденные файлы",
        "description": "Исходные файлы сохраняются.",
        "as": "file",
        "params": {
          "items": "{{found_files}}"
        },
        "steps": [
          {
            "action": "file_copy",
            "title": "Скопировать XML",
            "description": "Скопировать XML",
            "params": {
              "source": "{{file.path}}",
              "destination": "{{archive_dir}}/{{file.filename}}"
            }
          }
        ]
      }
    ],
    "output": {
      "Rezult_1": {
        "state": "completed"
      }
    }
  }
}
