{
  "name": "script-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal MVP API for distributed script execution planning.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "demo:reset": "node demo/reset.mjs",
    "demo:queue": "node demo/queue.mjs",
    "demo:success": "node demo/run.mjs success",
    "demo:error": "node demo/run.mjs file-not-found",
    "demo:retry": "node demo/run.mjs retry",
    "demo:timeout": "node demo/run.mjs timeout",
    "demo:all": "node demo/run.mjs success && node demo/run.mjs file-not-found && node demo/run.mjs retry && node demo/run.mjs timeout"
  }
}
