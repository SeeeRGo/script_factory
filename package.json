{
  "name": "script-factory",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Queued JSON automation service with native Chrome Recorder and Puppeteer Replay execution.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "demo:reset": "node demo/reset.mjs",
    "demo:queue": "node demo/queue.mjs",
    "demo:queue:priority-error": "node demo/run-queue-case.mjs priority-error",
    "demo:queue:running-low": "node demo/run-queue-case.mjs running-low",
    "demo:success": "node demo/run.mjs success",
    "demo:error": "node demo/run.mjs file-not-found",
    "demo:retry": "node demo/run.mjs retry",
    "demo:timeout": "node demo/run.mjs timeout",
    "demo:browser": "node demo/run-browser.mjs",
    "demo:yandex": "node demo/run-yandex.mjs",
    "demo:all": "node demo/run.mjs success && node demo/run.mjs file-not-found && node demo/run.mjs retry && node demo/run.mjs timeout"
  },
  "dependencies": {
    "@puppeteer/replay": "^4.0.2",
    "puppeteer": "^25.4.0"
  }
}
