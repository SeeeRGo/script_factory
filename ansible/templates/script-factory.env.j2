PUPPETEER_EXECUTABLE_PATH="{{ script_factory_browser_path }}"
BROWSER_STEP_DELAY_MS={{ script_factory_browser_step_delay_ms }}
BROWSER_HOLD_OPEN_MS={{ script_factory_browser_hold_open_ms }}
BROWSER_CAPTCHA_WAIT_MS={{ script_factory_browser_captcha_wait_ms }}
BROWSER_WINDOW_WIDTH={{ script_factory_browser_window_width }}
BROWSER_WINDOW_HEIGHT={{ script_factory_browser_window_height }}
NOVNC_ENABLED=false
FILESYSTEM_ALLOWED_ROOTS="{{ script_factory_allowed_roots | join(';') }}"
